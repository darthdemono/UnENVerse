{
  "version": 1,
  "comment": "The token registry (R41): one descriptor per token. vault_core::recipe implements each id; a test fails when a descriptor has no implementation or the reverse. The desktop draws its token forms from this file.",
  "tokens": [
    {
      "id": "random",
      "group": "Random",
      "kind": "random",
      "label": "Random characters",
      "summary": "N characters from an alphabet (safe, base62, base36, base32, hex, digits, letters, lower, upper, symbols, or your own characters).",
      "args": [
        {
          "name": "length",
          "type": "int",
          "default": "16"
        },
        {
          "name": "alphabet",
          "type": "text",
          "default": "safe"
        }
      ],
      "bits": "length x log2(alphabet size)",
      "example": "{random:16:safe}"
    },
    {
      "id": "digits",
      "group": "Random",
      "kind": "random",
      "label": "Random digits",
      "summary": "N random digits.",
      "args": [
        {
          "name": "length",
          "type": "int",
          "default": "4"
        }
      ],
      "bits": "length x 3.32",
      "example": "{digits:4}"
    },
    {
      "id": "letters",
      "group": "Random",
      "kind": "random",
      "label": "Random letters",
      "summary": "N random letters, both cases.",
      "args": [
        {
          "name": "length",
          "type": "int",
          "default": "8"
        }
      ],
      "bits": "length x 5.7",
      "example": "{letters:8}"
    },
    {
      "id": "hex",
      "group": "Random",
      "kind": "random",
      "label": "Random hex",
      "summary": "N random hexadecimal characters.",
