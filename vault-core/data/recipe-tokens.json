      "group": "Random",
      "kind": "random",
      "label": "Random base32",
      "summary": "N characters of Crockford base32.",
      "args": [
        {
          "name": "length",
          "type": "int",
          "default": "8"
        }
      ],
      "bits": "length x 5",
      "example": "{base32:8}"
    },
    {
      "id": "base36",
      "group": "Random",
      "kind": "random",
